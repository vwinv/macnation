# --- Serveur ---
PORT=3001
JWT_SECRET=change-me-in-production
# Origine du site public : sert aux IPN PayTech et aux pages de retour.
SITE_URL=https://mac-nation.vercel.app
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/mac_nation?schema=public"

# --- Backoffice ---
# Mot de passe unique du backoffice (POST /api/admin/login).
ADMIN_PASSWORD=

# --- PayTech (Mobile Money) ---
# Clés depuis le dashboard PayTech → Paramètres → API.
# Sans ces clés, POST /api/paytech/* répond 503 sans casser le reste.
# env=test débité 100–150 F (compte non activé = test seulement).
PAYTECH_API_KEY=
PAYTECH_API_SECRET=
PAYTECH_ENV=test
# IPN HTTPS obligatoire. Si SITE_URL est en http (localhost), on utilise
# https://mac-nation.vercel.app/api/paytech/ipn. Pour forcer une autre URL :
# PAYTECH_IPN_URL=https://ton-domaine/api/paytech/ipn

# --- PayDunya (ancien, non utilisé pour le checkout) ---
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_TOKEN=

# --- Notifications (toutes optionnelles) ---
# Une configuration incomplète est ignorée : jamais d'erreur côté client.
# JSON du compte de service Firebase (fichier ou contenu brut) pour les push FCM.
# FIREBASE_SERVICE_ACCOUNT=/chemin/vers/firebase-adminsdk.json
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
WHATSAPP_FROM=
WHATSAPP_CONTENT_SID=
BOOKING_SMS_TO=

# SMTP (Gmail : mot de passe d’application). Expéditeur = MAIL_USER, destinataire = client.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_NAME="Mac Nation"

# --- Connexion sociale ---
GOOGLE_CLIENT_ID=129490321592-g0j6qkpi3fe42994j024usllstbup0ii.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=129490321592-lgqdqkmebvn5qeb1jd4qothosu85cil0.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=129490321592-20nr6hgp013ufcda3nr04030h8i91g1q.apps.googleusercontent.com
# Sign in with Apple
# Services ID web (Apple Developer → Identifiers → Services IDs), ex. com.macnation.web
APPLE_CLIENT_ID=
# Bundle ID de l’app iOS/macOS (App ID avec capability Sign in with Apple)
APPLE_BUNDLE_ID=com.macnation.appmobile
# Fichier de vérif domaine (contenu téléchargé depuis Apple), servi par le site
# APPLE_DOMAIN_ASSOCIATION=
# App Facebook (Meta Developers). Les deux sont requis pour activer Facebook.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# --- Cloudinary (photos produits, site et CV candidatures) ---
# Dashboard Cloudinary → Settings → Product environment credentials.
# Cloud name, API key et API secret doivent appartenir au même cloud.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=macnation
# Alternative : une seule URL (cloudinary://API_KEY:API_SECRET@CLOUD_NAME)
# CLOUDINARY_URL=
