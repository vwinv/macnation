# URL de l’API Nest (site + app). En local : http://localhost:3001
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optionnel : IDs OAuth côté navigateur (sinon /api/compte/oauth/config les fournit)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_CLIENT_ID=com.macnation.web
NEXT_PUBLIC_FACEBOOK_APP_ID=

# Contenu du fichier Apple Developer → Domain verification
# (coller le texte téléchargé, une seule ligne)
APPLE_DOMAIN_ASSOCIATION=
